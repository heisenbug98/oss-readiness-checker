{
  "name": "oss-ready",
  "version": "0.3.1",
  "description": "A tiny CLI that checks whether a repository has the basic signals expected from a maintained open source project.",
  "type": "module",
  "bin": {
    "oss-ready": "bin/oss-ready.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node ./bin/oss-ready.js .",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "open-source",
    "maintainer",
    "cli",
    "github",
    "readiness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heisenbug98/oss-readiness-checker.git"
  },
  "bugs": {
    "url": "https://github.com/heisenbug98/oss-readiness-checker/issues"
  },
  "homepage": "https://github.com/heisenbug98/oss-readiness-checker#readme",
  "files": [
    "bin",
    "src",
    "docs",
    "examples",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "MAINTAINERS.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
